# Copy to .env and fill in -- docker-compose.yml reads these automatically.
# Get EBAY_CLIENT_ID / EBAY_CLIENT_SECRET from the eBay Developer Program
# (free, self-serve): https://developer.ebay.com -- see README for the
# exact steps.

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Optional -- eBay Partner Network campaign ID, tags listing links for
# affiliate commission. Leave blank to skip.
EBAY_EPN_CAMPAIGN_ID=

# Set to "sandbox" to point at eBay's Sandbox instead of Production --
# useful for a first smoke test (confirms auth/requests work) before
# trusting this against real listings. Needs its own separate Sandbox
# keyset (same Application Keys page, Sandbox tab) -- Production keys
# don't work in Sandbox and vice versa. Sandbox data is entirely fake, so
# this only proves the plumbing works, not that search results/pricing
# make sense. Leave unset (or "production") for real use.
EBAY_ENV=

# Which eBay category to search within -- the Browse API only allows one
# category per search. Defaults to 261328 (Sports Trading Cards). Collecting
# TCGs (Magic, Pokemon, Yu-Gi-Oh, etc.) instead? Set this to 183454 (CCG
# Individual Cards). Leave blank to use the sports default.
EBAY_CATEGORY_ID=
